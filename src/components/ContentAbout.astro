---
import { Code } from 'astro:components';

const code = `import type { ContactType, Developer, Education, TechStack } from './about.types';

const techStack: TechStack = {
    devOps: [
        'Git',
        'GitHub',
        'Docker',
        'Vercel',
        'AWS',
        'Azure'
    ],
    frontend: [
        'TypeScript',
        'JavaScript',
        'React',
        'Next.js',
        'Astro',
        'TailwindCSS'
    ],
    backend: [
        'Node.js',
        'Bun',
        'Nest.js',
        'Express.js',
        'Elysia.js',
        'PostgreSQL',
        'MySQL',
        'MongoDB',
        'Supabase',
        'Prisma'
    ]
};

const programmingLanguages: string[] = [
    'TypeScript',
    'JavaScript',
    'Python',
    'C++',
    'Java',
    'Dart',
    'Kotlin'
];

const education: Education[] = [
    {
        school: 'Universitas Darussalam Gontor',
        degree: 'Bachelor of Information Technology',
        period: '2024 - 2028'
    },
    {
        school: 'Darussalam Gontor Modern Boarding School',
        degree: 'Middle & High School',
        period: '2018 - 2024'
    }
];

const languages: Record<string, string> = {
    Indonesian: 'Native',
    English: 'Full Professional',
    Arabic: 'Full Professional'
};

// Developer profile
const me: Developer = {
    name: 'Mustaqim Nawahhudi Ma\\'arif',
    skills: [
        ...techStack.devOps,
        ...techStack.backend,
        ...techStack.frontend
    ],
    interests: [
        'Open Source',
        'Web Development',
        'Cloud Computing',
        'AI Engineering',
        'Networking',
        'Performance'
    ]
};

// Contact function
const contact = (type: ContactType): string => {
    switch (type) {
        case 'github':
            return 'https://github.com/mcqeems';
        case 'twitter':
            return 'https://x.com/mcqeems';
        case 'linkedIn':
            return 'https://www.linkedin.com/in/mcqeems';
        case 'instagram':
            return 'https://www.instagram.com/mcqeems/';
        case 'email':
            return 'mcqeemsofficial@gmail.com';
        default:
            return 'Send fax.';
    }
};

`;
---

<Code
    code={code}
    lang="ts"
    wrap={true}
/>

<style is:global>
    @reference "../styles/global.css";

    /* Custom styling for code block line numbers */
    pre.astro-code {
        @apply bg-transparent!;
    }

    pre.astro-code code {
        @apply block;
        counter-reset: step;
        counter-increment: step 0;
    }

    pre.astro-code code .line {
        @apply relative;
    }

    pre.astro-code code .line::before {
        content: counter(step);
        counter-increment: step;
        @apply text-gray-600 pr-2;
    }

</style>
