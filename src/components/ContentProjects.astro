---
interface Project {
  name: string;
  description: string;
  // Fill in per project — delete a line to hide that button
  website?: string;
  github?: string;
}

const projects: Project[] = [
  {
    name: "Purrmanent",
    description: "Your 90-day survival guide to being a cat parent.",
    website: "https://purrmanent.web.id",
    github: "https://github.com/mcqeems/purrmanent",
  },
  {
    name: "Seranah — UNIDA Gontor",
    description:
      "E-Archive and Correspondence System of Darussalam Gontor University.",
    website: "https://seranah.unida.gontor.ac.id",
  },
  {
    name: "DermaSight",
    description:
      "AI skin disease classification and severity scoring system. Coding Camp capstone project.",
    website: "https://dermasight.my.id",
    github: "https://github.com/DermaSight/dermasight",
  },
  {
    name: "Sedia",
    description:
      "Monitors weather and potential disasters: forecasts, early warnings and analytical summaries for preparedness.",
    website: "https://sedia.mustaqim.web.id",
    github: "https://github.com/mcqeems/sedia",
  },
  {
    name: "OSPEK Akhyar 2026",
    description: "Official website for OSPEK UNIDA Gontor 2026 (AKHYAR).",
    github: "https://ospek.unida.gontor.ac.id",
  },
  {
    name: "Nazzava",
    description: "Digital platform focused on education and green environment.",
    github: "https://github.com/mcqeems/nazzava",
  },
  {
    name: "Nutrisys",
    description: "AI-powered health and wellness platform.",
    website: "https://nutrisys.my.id",
    github: "https://github.com/mcqeems/nutrisys",
  },
  {
    name: "LinkMatch",
    description:
      "Professional networking platform connecting recruiters and talents. Built for the AWS Hackathon.",
    github: "https://github.com/mcqeems/link-match",
  },
  {
    name: "Recapify",
    description: "Open-source invoices recapitulation system.",
    github: "https://github.com/mcqeems/recapify",
  },
  {
    name: "Podahoras",
    description:
      "Learn Batak and the Batak script (Aksara Batak) through an interactive web platform.",
    github: "https://github.com/mcqeems/aksara_batak",
  },
  {
    name: "Renaissance",
    description:
      "Self-support and education app for preventing online-gambling harm (SDG-3). Winner of the elevAIte Hackathon by Dicoding.",
    github: "https://github.com/mcqeems/renaissance",
  },
  {
    name: "Jurumiyah",
    description:
      "Learning platform for Jurumiyah (nahwu), built with Astro and MeiliSearch.",
    website: "https://jurumiyah.id/",
  },
];
---

<div>
  <!-- <h2 class="text-2xl font-bold text-white mb-4">Latest Projects</h2> -->

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {projects.map((project) => (
      <div class="flex flex-col items-start justify-between border border-gray-700 rounded-lg p-4 bg-black">
        <div>
          <h3 class="text-xl font-semibold text-white mb-2">{project.name}</h3>
          <p class="text-gray-400">{project.description}</p>
        </div>

        {project.website || project.github ? (
          <div class="flex gap-2 w-full mt-4">
            {project.website ? (
              <a
                href={project.website}
                title={project.name + " website"}
                target="_blank"
                class="flex-1 px-4 py-2.5 text-center
                                        border border-gray-600 rounded-lg
                                        hover:text-primary
                                        hover:border-primary"
              >
                Open Website
              </a>
            ) : null}

            {project.github ? (
              <a
                href={project.github}
                title={project.name + " on GitHub"}
                target="_blank"
                class="flex-1 px-4 py-2.5 text-center
                                        border border-gray-600 rounded-lg
                                        hover:text-primary
                                        hover:border-primary"
              >
                Open GitHub
              </a>
            ) : null}
          </div>
        ) : null}
      </div>
    ))}
  </div>
</div>
